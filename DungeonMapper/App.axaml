<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DungeonMapper.App"
             xmlns:local="using:DungeonMapper"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- thin scrollbar: ScrollBarSize drives the thumb height, arrow-button
             size, and min-height, and it expands on hover. Slim it to 8. -->
        <x:Double x:Key="ScrollBarSize">8</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- ColorPicker styles are NOT bundled into FluentTheme; include them
             explicitly so the picker (spectrum/sliders) renders. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>