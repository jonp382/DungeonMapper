<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DungeonMapper.App"
             xmlns:local="using:DungeonMapper"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- thin horizontal scrollbar: the default FluentTheme bar is tall.
             the ScrollViewer template names its horizontal bar PART_HorizontalScrollBar,
             sized by its Height, so a template selector slims it. -->
        <Style Selector="ScrollViewer /template/ ScrollBar#PART_HorizontalScrollBar">
            <Setter Property="Height" Value="8" />
        </Style>
    </Application.Styles>
</Application>