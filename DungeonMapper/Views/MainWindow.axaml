<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonMapper.Controls"
        xmlns:views="using:DungeonMapper.Views"
        x:Class="DungeonMapper.Views.MainWindow"
        Icon="/Assets/DMRoom2.png"
        Title="Dungeon Mapper"
        Width="1100" Height="700">

    <Window.Styles>
        <!-- hotbar buttons: flat squares, a soft fill on hover and an accent
             fill on the active tool -->
        <Style Selector="Button.hot">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.hot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2c2c38" />
            <Setter Property="BorderBrush" Value="#3a3a48" />
        </Style>
        <Style Selector="Button.hot:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3a3a4a" />
        </Style>
        <Style Selector="Button.hot.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2f4a6e" />
            <Setter Property="BorderBrush" Value="#5d8ac4" />
        </Style>
        <Style Selector="Button.hot:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- thin divider between hotbar groups -->
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="#34343f" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- top area: a thin menu strip (file, manage) over the icon hotbar.
             both are forced dark so they match the canvas chrome whatever the
             system theme is. -->
        <ThemeVariantScope DockPanel.Dock="Top" RequestedThemeVariant="Dark">
            <StackPanel>
                <Border Background="#121218" BorderBrush="#2a2a34" BorderThickness="0,0,0,1">
                    <Menu x:Name="MainMenu" Padding="2,0">
                        <MenuItem Header="_File">
                            <MenuItem x:Name="MenuSave" Header="_Save campaign" InputGesture="Ctrl+S" />
                            <MenuItem x:Name="MenuSaveAs" Header="Save campaign _as..." />
                            <MenuItem x:Name="MenuLoad" Header="_Open campaign..." />
                            <Separator />
                            <MenuItem x:Name="MenuImportMaps" Header="_Import maps..." />
                            <MenuItem x:Name="MenuExportMap" Header="_Export current map..." />
                            <Separator />
                            <MenuItem x:Name="MenuSettings" Header="Se_ttings..." />
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem x:Name="MenuUndo" Header="_Undo" InputGesture="Ctrl+Z" />
                            <MenuItem x:Name="MenuRedo" Header="_Redo" InputGesture="Ctrl+Y" />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem x:Name="MenuFit" Header="Zoom to _fit" />
                        </MenuItem>
                        <MenuItem Header="_Manage">
                            <MenuItem x:Name="MenuMaps" Header="_Maps..." />
                            <MenuItem x:Name="MenuPawns" Header="_Pawns..." />
                            <MenuItem x:Name="MenuDoorPresets" Header="_Door presets..." />
                            <MenuItem x:Name="MenuHotkeys" Header="_Hotkeys..." />
                        </MenuItem>
                    </Menu>
                </Border>
                <!-- hotbar: icon only buttons, grouped, tooltips carry the names
                     and hotkeys. wraps on narrow windows. -->
                <Border Background="#1a1a22" BorderBrush="#2a2a34" BorderThickness="0,0,0,1" Padding="8,5">
                    <DockPanel>
                        <!-- map switching sits at the right end of the bar -->
                        <WrapPanel ItemSpacing="2" LineSpacing="4" VerticalAlignment="Center">
                            <Button x:Name="ToolSelect" Classes="hot" />
                            <Button x:Name="ToolMove" Classes="hot" />
                            <Border Classes="sep" />
                            <Button x:Name="ToolRoom" Classes="hot" />
                            <Button x:Name="ToolFloor" Classes="hot" />
                            <Button x:Name="ToolWall" Classes="hot" />
                            <Button x:Name="ToolPolygon" Classes="hot" />
                            <Border Classes="sep" />
                            <Button x:Name="ToolDoor" Classes="hot" />
                            <Button x:Name="ToolStair" Classes="hot" />
                            <Button x:Name="ToolLabel" Classes="hot" />
                            <Button x:Name="ToolPawn" Classes="hot" />
                            <Border Classes="sep" />
                            <Button x:Name="ToolErase" Classes="hot" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ThemeVariantScope>

        <!-- status bar, the bottom-most strip. the fill is the dark theme's
             ButtonBackground over the old toolbar color, the same gray the text
             buttons had before they became icons. -->
        <ThemeVariantScope DockPanel.Dock="Bottom" RequestedThemeVariant="Dark">
            <Border Background="#1a1a22">
                <Border Background="{DynamicResource ButtonBackground}" Padding="10,3">
                    <TextBlock x:Name="StatusText" Text="right-drag: pan, wheel: zoom"
                               Foreground="White" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Border>
        </ThemeVariantScope>

        <!-- map strip above the status bar: switch maps from the dropdown, the
             button opens the floating maps panel for everything else -->
        <ThemeVariantScope DockPanel.Dock="Bottom" RequestedThemeVariant="Dark">
            <Border Background="#1a1a22" BorderBrush="#2a2a34" BorderThickness="0,1,0,0" Padding="8,3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="BtnManageMaps" Classes="hot" Width="30" Height="30" />
                    <ComboBox x:Name="MapList" MinWidth="180" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </ThemeVariantScope>

        <Panel>
            <controls:MapCanvas x:Name="Canvas" />
            <views:ToolPanel x:Name="ToolPanel" Background="{DynamicResource Ui.Bg.Panel}" />
            <!-- pawn management and the import pickers. the frame, header and
                 tabs are fixed here, MainWindow.Pawns.cs and PresetImport.cs
                 build the body. the tabs and close only show for management. -->
            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="ModalOverlay" Classes="modal" IsVisible="False" Width="760" Height="640">
                    <DockPanel>
                        <Border x:Name="ModalHeader" Classes="header" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <StackPanel x:Name="ModalTitleStack" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModalTitle" Classes="title" />
                                    <TextBlock x:Name="ModalSubtitle" Classes="muted" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" IsVisible="False" />
                                </StackPanel>
                                <StackPanel x:Name="ModalTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="ManageTabPawns" Classes="tab" Content="Pawns" />
                                    <Button x:Name="ManageTabAffiliations" Classes="tab" Content="Affiliations" />
                                    <Button x:Name="ManageTabStatuses" Classes="tab" Content="Status styles" />
                                </StackPanel>
                                <Button x:Name="ModalClose" Grid.Column="3" Classes="btn" Content="close" />
                            </Grid>
                        </Border>
                        <Border x:Name="ModalBody" />
                    </DockPanel>
                </Border>
            </ThemeVariantScope>
            <!-- settings modal on the shared look in Styles/Ui.axaml. every row
                 is fixed here, MainWindow.Settings.cs fills the values and puts
                 the color buttons into the hosts. -->
            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SettingsOverlay" Classes="modal" IsVisible="False" Width="540" Height="540">
                    <DockPanel>
                        <Border Classes="header" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="title" Text="Settings" />
                                <Button x:Name="SettingsClose" Grid.Column="1" Classes="btn" Content="close" />
                            </Grid>
                        </Border>
                        <Border Classes="footer" DockPanel.Dock="Bottom" Margin="14,0,14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="changes show right away and are saved when you close." />
                                <Button x:Name="SettingsImport" Grid.Column="1" Classes="btn" Content="import..." Margin="10,0,0,0"
                                        ToolTip.Tip="replace the app settings and hotkeys with ones from a file. door presets, pawn statuses and affiliation colors stay as they are" />
                                <Button x:Name="SettingsExport" Grid.Column="2" Classes="btn" Content="export..." Margin="6,0,0,0"
                                        ToolTip.Tip="save the app settings and hotkeys to a file" />
                                <Button x:Name="SettingsResetAll" Grid.Column="3" Classes="btn" Content="reset all" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12,14,12" Spacing="6">

                                <TextBlock Classes="section" Text="grid" />
                                <Border Classes="group">
                                    <StackPanel Spacing="8">
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="major lines every" />
                                                <TextBlock Classes="hint" Text="cells between major lines, 1 to 100. a cell is 5 ft." />
                                                <TextBlock x:Name="SetGridSpacingError" Classes="refusal" IsVisible="False" />
                                            </StackPanel>
                                            <TextBox x:Name="SetGridSpacing" Grid.Column="1" Classes="field number" />
                                            <Button x:Name="ResetGridSpacing" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="major line color" />
                                            <ContentControl x:Name="SetMajorColor" Grid.Column="1" />
                                            <Button x:Name="ResetMajorColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,Auto,58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="minor lines" />
                                                <TextBlock Classes="hint" Text="every cell edge between major lines." />
                                            </StackPanel>
                                            <CheckBox x:Name="SetShowMinor" Grid.Column="1" Classes="toggle" Content="show" Margin="0,0,10,0" />
                                            <ContentControl x:Name="SetMinorColor" Grid.Column="2" />
                                            <Button x:Name="ResetMinorColor" Grid.Column="3" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,Auto,58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="floor grid opacity" />
                                                <TextBlock Classes="hint" Text="lines inside rooms, percent 0 to 100." />
                                                <TextBlock x:Name="SetFloorGridOpacityError" Classes="refusal" IsVisible="False" />
                                            </StackPanel>
                                            <Slider x:Name="SetFloorGridOpacitySlider" Grid.Column="1" Width="110" Minimum="0" Maximum="100"
                                                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox x:Name="SetFloorGridOpacity" Grid.Column="2" Classes="field number" />
                                            <Button x:Name="ResetFloorGridOpacity" Grid.Column="3" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="grid dots" />
                                                <TextBlock Classes="hint" Text="the dots in empty space." />
                                            </StackPanel>
                                            <ContentControl x:Name="SetDotColor" Grid.Column="1" />
                                            <Button x:Name="ResetDotColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="section" Text="map colors" />
                                <Border Classes="group">
                                    <StackPanel Spacing="8">
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="background" />
                                            <ContentControl x:Name="SetBackgroundColor" Grid.Column="1" />
                                            <Button x:Name="ResetBackgroundColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="room fill" />
                                            <ContentControl x:Name="SetCellColor" Grid.Column="1" />
                                            <Button x:Name="ResetCellColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="walls" />
                                            <ContentControl x:Name="SetWallColor" Grid.Column="1" />
                                            <Button x:Name="ResetWallColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="body" Text="wall thickness" />
                                                <TextBlock x:Name="SetWallThicknessHint" Classes="hint" />
                                                <TextBlock x:Name="SetWallThicknessError" Classes="refusal" IsVisible="False" />
                                            </StackPanel>
                                            <TextBox x:Name="SetWallThickness" Grid.Column="1" Classes="field number" />
                                            <Button x:Name="ResetWallThickness" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="stairs" />
                                            <ContentControl x:Name="SetStairColor" Grid.Column="1" />
                                            <Button x:Name="ResetStairColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                        <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                            <TextBlock Classes="body" Text="labels" />
                                            <ContentControl x:Name="SetLabelColor" Grid.Column="1" />
                                            <Button x:Name="ResetLabelColor" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="section" Text="new labels" />
                                <Border Classes="group">
                                    <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="body" Text="starting text" />
                                            <TextBlock Classes="hint" Text="what a label says when you place it." />
                                            <TextBlock x:Name="SetLabelTextError" Classes="refusal" IsVisible="False" />
                                        </StackPanel>
                                        <TextBox x:Name="SetLabelText" Grid.Column="1" Classes="field" Width="160" />
                                        <Button x:Name="ResetLabelText" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                    </Grid>
                                </Border>

                                <TextBlock Classes="section" Text="saving" />
                                <Border Classes="group">
                                    <Grid Classes="setting" ColumnDefinitions="*,Auto,58">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="body" Text="autosave every" />
                                            <TextBlock x:Name="SetAutosaveHint" Classes="hint" />
                                            <TextBlock x:Name="SetAutosaveError" Classes="refusal" IsVisible="False" />
                                        </StackPanel>
                                        <TextBox x:Name="SetAutosave" Grid.Column="1" Classes="field number" />
                                        <Button x:Name="ResetAutosave" Grid.Column="2" Classes="btn quiet" Content="reset" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ThemeVariantScope>
            <!-- door presets modal. first menu on the shared look in
                 Styles/Ui.axaml: the frame, header, editor and footer are fixed
                 here, only the rows are built in code (MainWindow.DoorPresets.cs) -->
            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="DoorPresetsOverlay" Classes="modal" IsVisible="False" Width="660" Height="480">
                    <DockPanel>
                        <Border Classes="header" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="title" Text="Door presets" />
                                <Button x:Name="DoorPresetsClose" Grid.Column="1" Classes="btn" Content="close" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,1,280">
                            <!-- left: the door types -->
                            <DockPanel Margin="12,12,12,10">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBlock Classes="muted" VerticalAlignment="Center"
                                               Text="door types color the doors on the map. counts are this map and the whole campaign." />
                                    <Button x:Name="DoorAdd" Grid.Column="1" Classes="btn primary" Content="+ add door type" Margin="10,0,0,0" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Classes="colhead">
                                    <Grid ColumnDefinitions="30,*,60,70">
                                        <TextBlock Classes="colhead" Text="color" />
                                        <TextBlock Classes="colhead" Grid.Column="1" Text="name" />
                                        <TextBlock Classes="colhead" Grid.Column="2" Text="on map" HorizontalAlignment="Right" />
                                        <TextBlock Classes="colhead" Grid.Column="3" Text="campaign" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Classes="footer">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="DoorFooter" Classes="muted" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="DoorImport" Classes="btn" Content="import..."
                                                    ToolTip.Tip="add door types from a presets, campaign or map file. names you already have are never changed." />
                                            <Button x:Name="DoorExport" Classes="btn" Content="export all"
                                                    ToolTip.Tip="save this campaign's door types to a file" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DoorRows" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border Grid.Column="1" Classes="divider" />
                            <!-- right: editor for the selected type -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,12,14,12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                                        <Border x:Name="DoorPreview" Width="36" Height="10" CornerRadius="2" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DoorPreviewName" Classes="body strong" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Classes="label" Text="NAME" />
                                    <TextBox x:Name="DoorName" Classes="field" />
                                    <TextBlock x:Name="DoorNameError" Classes="refusal" IsVisible="False" Margin="0,4,0,0" />
                                    <TextBlock Classes="label" Text="COLOR" />
                                    <ContentControl x:Name="DoorColorHost" />
                                    <TextBlock Classes="label" Text="DEFAULT" />
                                    <Button x:Name="DoorMakeDefault" Classes="btn" Content="set as default" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="DoorDefaultNote" Classes="muted" FontSize="11" Margin="0,4,0,0"
                                               Text="new doors are placed as this type." />
                                    <Border Classes="infobox" Margin="0,12,0,0">
                                        <TextBlock x:Name="DoorUsage" Classes="muted" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                                        <Button x:Name="DoorDuplicate" Classes="btn" Content="duplicate" />
                                        <Button x:Name="DoorDelete" Classes="btn danger" Content="delete" />
                                    </StackPanel>
                                    <TextBlock x:Name="DoorDeleteNote" Classes="muted" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </ThemeVariantScope>
            <!-- floating maps panel over the bottom left of the map, opened from
                 the map strip. not modal: the map stays usable behind it. the
                 frame is fixed here, MainWindow.Maps.cs builds the rows into
                 MapsRows. -->
            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8">
                <Border x:Name="MapsOverlay" Classes="modal" IsVisible="False" Width="500">
                    <DockPanel>
                        <Border Classes="header" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="title" Text="Maps in this campaign" />
                                <Button x:Name="MapsClose" Grid.Column="1" Classes="btn" Content="close" />
                            </Grid>
                        </Border>
                        <Border Classes="footer" DockPanel.Dock="Bottom" Margin="14,0,14,10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="MapsAdd" Classes="btn primary" Content="+ new map" />
                                <Button x:Name="MapsImport" Classes="btn" Content="import maps..." />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Margin="14,10,14,7">
                            <StackPanel x:Name="MapsRows" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ThemeVariantScope>
            <!-- hotkeys modal: one letter per tool, then the fixed shortcuts.
                 the frame is fixed here, MainWindow.Hotkeys.cs builds the tool
                 rows into HotkeyRows and the shortcut rows into FixedKeyRows. -->
            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="HotkeysOverlay" Classes="modal" IsVisible="False" Width="480" Height="580">
                    <DockPanel>
                        <Border Classes="header" DockPanel.Dock="Top">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="title" Text="Hotkeys" />
                                <Button x:Name="HotkeysClose" Grid.Column="1" Classes="btn" Content="close" />
                            </Grid>
                        </Border>
                        <Border Classes="footer" DockPanel.Dock="Bottom" Margin="14,0,14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                                           Text="changes apply right away and are saved when you close." />
                                <Button x:Name="HotkeysResetAll" Grid.Column="1" Classes="btn" Content="reset all" Margin="10,0,0,0" />
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12,14,12" Spacing="6">
                                <TextBlock Classes="section" Text="tools" />
                                <TextBlock Classes="hint" Text="click a box and press a letter. hotkeys do nothing while you type in a text box." />
                                <Border Classes="group">
                                    <StackPanel x:Name="HotkeyRows" Spacing="2" />
                                </Border>
                                <TextBlock Classes="section" Text="fixed shortcuts" Margin="2,12,0,0" />
                                <Border Classes="group">
                                    <StackPanel x:Name="FixedKeyRows" Spacing="6" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ThemeVariantScope>
        </Panel>
    </DockPanel>

</Window>
