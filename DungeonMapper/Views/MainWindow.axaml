<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DungeonMapper.Controls"
        xmlns:views="using:DungeonMapper.Views"
        x:Class="DungeonMapper.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Dungeon Mapper"
        Width="1100" Height="700">

    <DockPanel>
        <!-- toolbar wraps to multiple rows on narrow windows (no horizontal scroll
             needed below 2560x1440); padding trimmed to keep the bar compact -->
        <Border DockPanel.Dock="Top" Background="#1a1a22" Padding="6,4">
            <WrapPanel ItemSpacing="6" LineSpacing="4">
                <Button x:Name="ToolSelect" Content="Select" />
                <Button x:Name="ToolMove" Content="Move" />
                <Button x:Name="ToolRoom" Content="Room" />
                <Button x:Name="ToolFloor" Content="Floor" />
                <Button x:Name="ToolWall" Content="Wall" />
                <Button x:Name="ToolDoor" Content="Door" />
                <Button x:Name="ToolStair" Content="Stair" />
                <Button x:Name="ToolLabel" Content="Label" />
                <Button x:Name="ToolErase" Content="Erase" />
                <Button x:Name="ToolPawn" Content="Pawn" />
                <Button x:Name="ToolPolygon" Content="Polygon" />
                <Button x:Name="ToolLine" Content="Line" />
                <Separator/>
                <ComboBox x:Name="MapList" MinWidth="120" />
                <Button x:Name="BtnAddMap" Content="+Map" />
                <Button x:Name="BtnRenameMap" Content="Rename" />
                <Separator />
                <Button x:Name="BtnUndo" Content="Undo" />
                <Button x:Name="BtnRedo" Content="Redo" />
                <Separator />
                <Button x:Name="BtnSave" Content="Save" />
                <Button x:Name="BtnLoad" Content="Load" />
                <Button x:Name="BtnFit" Content="Fit" />
                <Separator />
                <Button x:Name="BtnSettings" Content="Settings" />
            </WrapPanel>
        </Border>

        <Panel>
            <controls:MapCanvas x:Name="Canvas" />
            <views:ToolPanel x:Name="ToolPanel" />
            <!-- modal popup for pawn management: centered over the map, hidden by
                 default. The library grid is virtualized (VirtualizingStackPanel)
                 so only visible rows render for performance. -->
            <Border x:Name="ModalOverlay" IsVisible="False"
                    Background="#22222c" BorderBrush="#444450" BorderThickness="1"
                    Width="440" MaxHeight="640" Padding="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Pawn management" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                        <Button x:Name="ModalClose" Content="close" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- body scrolls so affiliations + status styles fit at low
                         resolutions; the header (title + close) stays fixed.
                         explicit Height gives the ScrollViewer a real viewport (a
                         ScrollViewer reports desired height 0, so a content-sized
                         Border collapses it to zero and it never scrolls). -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="560">
                        <StackPanel Spacing="8">
                            <Button x:Name="ModalAddPawn" Content="+ add pawn" />
                            <StackPanel x:Name="ModalSortRow" Orientation="Horizontal" Spacing="6" />
                            <TextBlock Text="library (click a pawn to edit):" Foreground="White" FontSize="12" />
                            <!-- inner ScrollViewer gives the VirtualizingStackPanel a
                                 bounded viewport so only visible rows render -->
                            <ScrollViewer VerticalScrollBarVisibility="Visible" MaxHeight="320">
                                <ItemsControl x:Name="LibraryGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="affiliation colors (outer + inner):" Foreground="White" FontSize="12" />
                            <StackPanel x:Name="ModalAffiliations" Spacing="4" />
                            <TextBlock Text="status styles (name -> #hex, thickness):" Foreground="White" FontSize="12" />
                            <StackPanel x:Name="ModalStatuses" Spacing="4" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <!-- settings modal: centered popup like Pawn Management. Sections are
                 built in code (ShowSettingsModal) into SettingsSections. -->
            <Border x:Name="SettingsOverlay" IsVisible="False"
                    Background="#22222c" BorderBrush="#444450" BorderThickness="1"
                    Width="460" MaxHeight="640" Padding="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Settings" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                        <Button x:Name="SettingsClose" Content="close" Margin="8,0,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="560">
                        <StackPanel x:Name="SettingsSections" Spacing="10" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <!-- door presets modal: Manage Door Presets, opened from the Door tool.
                 Door categories (name + color) with add/remove; Standard is the
                 undeletable default. Door tool itself shows only placement options. -->
            <Border x:Name="DoorPresetsOverlay" IsVisible="False"
                    Background="#22222c" BorderBrush="#444450" BorderThickness="1"
                    Width="420" MaxHeight="640" Padding="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Manage Door Presets" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                        <Button x:Name="DoorPresetsClose" Content="close" Margin="8,0,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="560">
                        <StackPanel x:Name="DoorPresetsSections" Spacing="10" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="right-drag: pan, wheel: zoom"
                       Foreground="#aaa" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="8,0,0,4" />
        </Panel>
    </DockPanel>

</Window>
